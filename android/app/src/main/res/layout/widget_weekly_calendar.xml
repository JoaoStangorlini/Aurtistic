<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_rounded"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Controls on the left: Top (E), Middle (T), Bottom (+) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="6dp"
            android:paddingVertical="2dp">

            <!-- E (Top) -->
            <TextView
                android:id="@+id/btn_toggle_events"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="E"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_event_pill_default" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- T (Middle) -->
            <TextView
                android:id="@+id/btn_toggle_tasks"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="T"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_task_pill_default" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- + (Bottom) -->
            <FrameLayout
                android:id="@+id/btn_add_event"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_fab_add">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="#121212"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <!-- Left Week Arrow -->
        <FrameLayout
            android:id="@+id/btn_prev_week"
            android:layout_width="18dp"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="#8E8E8E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>
        
        <LinearLayout
            android:id="@+id/calendar_grid_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Right Week Arrow -->
        <FrameLayout
            android:id="@+id/btn_next_week"
            android:layout_width="18dp"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="#8E8E8E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
