<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_rounded"
    android:padding="8dp">

    <!-- Global Top Header: Dimensões (Left) and E, T, + (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/global_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/global_list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dimensões"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="Selecionar dimensão"
                android:tint="#A0A0A0"
                android:layout_marginStart="3dp" />
        </LinearLayout>

        <!-- Global Control Buttons (Afastados no topo) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/global_btn_toggle_events"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="E"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_event_pill_default"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/global_btn_toggle_tasks"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="T"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_task_pill_default"
                android:layout_marginEnd="18dp" />

            <FrameLayout
                android:id="@+id/global_btn_add_event"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_fab_add">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="#121212"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2D2D2D"
        android:layout_marginBottom="6dp" />

    <!-- Middle Half: 50% Month Calendar, 50% List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- Top Left: Month Calendar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/global_month_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agosto"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="D" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Q" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Q" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#8E8E8E" android:textSize="8sp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/global_month_grid_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2D2D2D"
            android:layout_marginHorizontal="2dp" />

        <!-- Top Right: List Widget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <ListView
                android:id="@+id/global_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:divider="@null"
                android:dividerHeight="4dp" />

            <TextView
                android:id="@+id/global_empty_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Nenhum item"
                android:textColor="#A0A0A0"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2D2D2D"
        android:layout_marginVertical="4dp" />

    <!-- Bottom Half: Weekly Calendar Horizontal -->
    <LinearLayout
        android:id="@+id/global_weekly_grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" />
</LinearLayout>
